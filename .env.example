# Neon Postgres ma'lumotlar bazasi ulanish havolasi (Neon dashboard > Connection string)
# Muhim: pooler URL ishlating va oxirida ?sslmode=require bo'lsin
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Admin panelga kirish paroli
ADMIN_PASSWORD=admin_maxfiy_parol_123

# Admin sessiyasi uchun JWT maxfiy kaliti (kamida 32 ta belgi)
SESSION_SECRET=super_secret_session_jwt_key_kamida_32_belgidan_iborat

# Django maxfiy kaliti (productionda albatta o'zgartiring)
SECRET_KEY=django-insecure-quiz-production-secret-key-change-this

# --- Lokal ishlatish ---
# DEBUG=True
# ALLOWED_HOSTS=*

# --- Vercel (Production) Environment Variables ---
DEBUG=False
ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.vercel.app
